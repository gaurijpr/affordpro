# AFFORDPRO BACKEND ENVIRONMENT VARIABLES (EXAMPLE)
# Copy to .env in your production environment and fill in real secret credentials

PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL="postgresql://user:password@host:5432/affordpro_db?sslmode=require"

# JWT Authentication Security Secret
JWT_SECRET="your_strong_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Cashfree Live Production Payment Gateway
CASHFREE_APP_ID="your_cashfree_app_id_here"
CASHFREE_SECRET_KEY="your_cashfree_secret_key_here"
CASHFREE_ENV="PRODUCTION"

# Razorpay Live Payment Gateway (Optional / Secondary)
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Allowed Frontend Domain & CORS Configuration
FRONTEND_URL="https://affordpro.com"
CORS_ORIGIN="https://affordpro.com,https://www.affordpro.com"
